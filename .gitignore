# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage/

# next.js
**/.next/
**/out/
/output/

# production
**/build/

# Flutter / Android / IDE generated files
**/.dart_tool/
**/.gradle/
**/.idea/
**/.kotlin/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/*.iml
**/local.properties
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh

# misc
.DS_Store
*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.mobileprovision
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing examples only)
**/.env*
!**/.env.example
next-dev-*.log

# vercel
.vercel

# temporary and generated reports
/.tmp/
/tmp/
**/tmp/
supabase/.temp/
/.worktrees/

# typescript
*.tsbuildinfo
**/next-env.d.ts
.dyad/
