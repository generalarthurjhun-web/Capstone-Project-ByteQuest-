# =============================================================================
# Supabase — ByteQuest. Copy to .env.local and fill in.
# =============================================================================

# Public client configuration (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Instructor quiz-drafting assistance. Server only; never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional: direct database connection for migrations and the Supabase CLI
DATABASE_URL=

# Local-only authenticated lifecycle tests; never commit the value.
BYTEQUEST_E2E_PASSWORD=
